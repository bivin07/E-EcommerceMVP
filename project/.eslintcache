ount: 8500` looks like it's in the smallest currency unit. Medusa expects prices in major units (decimals).","`amount: 12500` looks like it's in the smallest currency unit. Medusa expects prices in major units (decimals).","`amount: 14000` looks like it's in the smallest currency unit. Medusa expects prices in major units (decimals).","`amount: 18000` looks like it's in the smallest currency unit. Medusa expects prices in major units (decimals).","@medusajs/prefer-container-registration-keys","Use `ContainerRegistrationKeys.QUERY` instead of the magic string `query`.","preferRegistrationKey",{"range":"218","text":"219"},{"range":"220","text":"221"},"@medusajs/prefer-link-over-remote-link","`\"remoteLink\"` is deprecated. Resolve `\"link\"` (or `ContainerRegistrationKeys.LINK`) instead.","remoteLinkString",{"range":"222","text":"223"},"@medusajs/step-id-kebab-case","Step id `apply-referral-group-step` should match the enclosing variable name or filename (expected `apply-referral-group`).","idMismatch",{"range":"224","text":"225"},{"range":"226","text":"227"},"@medusajs/use-medusa-error-not-generic-error","Throw `MedusaError` instead of a generic `Error`. Use `new MedusaError(MedusaError.Types.X, \"...\")` so the error maps to the correct HTTP status.","NewExpression","useMedusaError",["228"],["229"],"Step id `generate-referral-code-step` should match the enclosing variable name or filename (expected `generate-referral-code`).",{"range":"230","text":"231"},{"range":"232","text":"223"},{"range":"233","text":"223"},{"range":"234","text":"235"},{"range":"236","text":"237"},"@medusajs/prefer-modules-enum","Use `Modules.ORDER` instead of the magic string `order`.","preferModulesEnum",{"range":"238","text":"239"},{"range":"240","text":"241"},{"range":"242","text":"243"},{"range":"244","text":"245"},{"range":"246","text":"247"},[0,358],"import { ContainerRegistrationKeys } from \"@medusajs/framework/utils\"\nimport { SubscriberConfig, SubscriberArgs } from \"@medusajs/framework\"\nimport { createElectricianReferralWorkflow } from \"../workflows/create-electrician-referral\"\n\nexport default async function electricianApprovedHandler({ event: { data }, container }: SubscriberArgs<{ id: string }>) {\n  const customerId = data.id\n  const query = container.resolve(ContainerRegistrationKeys.QUERY",[87,306],", ContainerRegistrationKeys } from \"@medusajs/framework/utils\"\n\nexport default async function orderPlacedHandler({ event: { data }, container }: SubscriberArgs<{ id: string }>) {\n  const orderId = data.id\n  const query = container.resolve(ContainerRegistrationKeys.QUERY",[347,359],"\"link\"",[330,357],"\"apply-referral-group\"",[127,473],", ContainerRegistrationKeys } from \"@medusajs/framework/utils\"\nimport { REFERRAL_MODULE } from \"../modules/referral\"\n\ntype ApplyReferralInput = {\n  customerId: string\n  code: string\n}\n\nconst applyReferralGroupStep = createStep(\n  \"apply-referral-group-step\",\n  async ({ customerId, code }: ApplyReferralInput, { container }) => {\n    const query = container.resolve(ContainerRegistrationKeys.QUERY",{"messageId":"248","data":"249","fix":"250","desc":"251"},{"messageId":"248","data":"252","fix":"253","desc":"251"},[329,358],"\"generate-referral-code\"",[557,569],[1548,1560],[0,200],"import { ContainerRegistrationKeys } from \"@medusajs/framework/utils\"\nimport { MedusaRequest, MedusaResponse } from \"@medusajs/framework\"\n\nexport async function GET(\n  req: MedusaRequest,\n  res: MedusaResponse\n): Promise<void> {\n  const query = req.scope.resolve(ContainerRegistrationKeys.QUERY",[0,387],"import { ContainerRegistrationKeys } from \"@medusajs/framework/utils\"\nimport { AuthenticatedMedusaRequest, MedusaResponse } from \"@medusajs/framework/http\"\n\nexport async function GET(\n  req: AuthenticatedMedusaRequest,\n  res: MedusaResponse\n): Promise<void> {\n  const customerId = req.auth_context?.actor_id\n\n  if (!customerId) {\n    res.status(401).json({ success: false, message: \"Unauthorized\" })\n    return\n  }\n\n  const query = req.scope.resolve(ContainerRegistrationKeys.QUERY",[0,1631],"import { Modules } from \"@medusajs/framework/utils\"\nimport { AuthenticatedMedusaRequest, MedusaResponse } from \"@medusajs/framework/http\"\n\nexport async function GET(\n  req: AuthenticatedMedusaRequest,\n  res: MedusaResponse\n): Promise<void> {\n  const customerId = req.auth_context?.actor_id\n\n  if (!customerId) {\n    res.status(401).json({ success: false, message: \"Unauthorized\" })\n    return\n  }\n\n  const query = req.scope.resolve(\"query\")\n  \n  const { data: customers } = await query.graph({\n    entity: \"customer\",\n    fields: [\"groups.*\", \"metadata\"],\n    filters: {\n      id: [customerId]\n    }\n  })\n\n  const customer = customers[0]\n  const isDeliveryAgent = customer?.groups?.some((g: any) => \n    g.name.toLowerCase() === \"delivery agents\" || g.name.toLowerCase() === \"delivery agent\"\n  )\n\n  if (!isDeliveryAgent) {\n    res.status(403).json({ success: false, message: \"Forbidden: You are not a Delivery Agent.\" })\n    return\n  }\n\n  // Get the serviceable pincodes from the agent's metadata\n  let servicePincodes: string[] = []\n  if (Array.isArray(customer.metadata?.service_pincodes)) {\n    servicePincodes = customer.metadata.service_pincodes as string[]\n  } else if (typeof customer.metadata?.service_pincodes === 'string') {\n    // sometimes it's saved as a comma separated string\n    servicePincodes = (customer.metadata.service_pincodes as string).split(',').map(s => s.trim())\n  }\n\n  // We must use order module instead of query.graph for orders because \n  // query.graph automatically scopes orders to the logged-in customer's ID!\n  // Since the Delivery Agent is a customer, it would only return their own orders.\n  const orderModuleService = req.scope.resolve(Modules.ORDER",[2911,2918],"ContainerRegistrationKeys.QUERY",[3554,3561],"Modules.ORDER",[0,211],"import { Modules } from \"@medusajs/framework/utils\"\nimport { MedusaRequest, MedusaResponse } from \"@medusajs/framework/http\"\n\nexport default async function testModuleQuery({ container }: { container: any }) {\n  const orderModuleService = container.resolve(Modules.ORDER",[0,211],"import { Modules } from \"@medusajs/framework/utils\"\nimport { MedusaRequest, MedusaResponse } from \"@medusajs/framework/http\"\n\nexport default async function testUpdateOrder({ container }: { container: any }) {\n  const orderModuleService = container.resolve(Modules.ORDER","replaceWithMedusaError",{"type":"254"},{"range":"255","text":"256"},"Replace with `new MedusaError(MedusaError.Types.UNEXPECTED_STATE, ...)` (pick the appropriate `MedusaError.Types.*`).",{"type":"254"},{"range":"257","text":"258"},"MedusaError.Types.UNEXPECTED_STATE",[127,856],", MedusaError } from \"@medusajs/framework/utils\"\nimport { REFERRAL_MODULE } from \"../modules/referral\"\n\ntype ApplyReferralInput = {\n  customerId: string\n  code: string\n}\n\nconst applyReferralGroupStep = createStep(\n  \"apply-referral-group-step\",\n  async ({ customerId, code }: ApplyReferralInput, { container }) => {\n    const query = container.resolve(\"query\")\n    const customerGroupService = container.resolve(Modules.CUSTOMER)\n\n    // 1. Verify the code exists and is active\n    const { data: [referralCode] } = await query.graph({\n      entity: \"referral_code\",\n      fields: [\"id\", \"code\", \"is_active\"],\n      filters: { code, is_active: true }\n    })\n\n    if (!referralCode) {\n      throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"Invalid or inactive referral code.\")",[127,1769],", MedusaError } from \"@medusajs/framework/utils\"\nimport { REFERRAL_MODULE } from \"../modules/referral\"\n\ntype ApplyReferralInput = {\n  customerId: string\n  code: string\n}\n\nconst applyReferralGroupStep = createStep(\n  \"apply-referral-group-step\",\n  async ({ customerId, code }: ApplyReferralInput, { container }) => {\n    const query = container.resolve(\"query\")\n    const customerGroupService = container.resolve(Modules.CUSTOMER)\n\n    // 1. Verify the code exists and is active\n    const { data: [referralCode] } = await query.graph({\n      entity: \"referral_code\",\n      fields: [\"id\", \"code\", \"is_active\"],\n      filters: { code, is_active: true }\n    })\n\n    if (!referralCode) {\n      throw new Error(\"Invalid or inactive referral code.\")\n    }\n\n    // 2. Find the \"Referred by Electrician\" group\n    const { data: [referredGroup] } = await query.graph({\n      entity: \"customer_group\",\n      fields: [\"id\", \"name\"],\n      filters: { name: \"Referred by Electrician\" }\n    })\n\n    let referredGroupId = referredGroup?.id\n\n    if (!referredGroupId) {\n      // Auto-create the group so the admin doesn't have to manually ensure it exists\n      const customerModuleService = container.resolve(Modules.CUSTOMER)\n      const newGroup = await customerModuleService.createCustomerGroups({\n        name: \"Referred by Electrician\"\n      })\n      referredGroupId = newGroup.id\n    }\n\n    // 3. Check if the customer is already in this group\n    const { data: [customer] } = await query.graph({\n      entity: \"customer\",\n      fields: [\"id\", \"groups.id\"],\n      filters: { id: customerId }\n    })\n\n    if (!customer) {\n      throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"Customer not found.\")"]